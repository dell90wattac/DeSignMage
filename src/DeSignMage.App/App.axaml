<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeSignMage.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <!-- Interface text size (R12). These are the 100% values; Shell/UiScale.cs overwrites them with the chosen scale at startup
         and whenever it changes. -->
    <x:Double x:Key="Ui.Scale">1</x:Double>
    <x:Double x:Key="Ui.IconScale">1</x:Double>
    <x:Double x:Key="Ui.FontSize">12</x:Double>
    <x:Double x:Key="Ui.SmallFontSize">11</x:Double>
    <x:Double x:Key="Ui.GlyphFontSize">15</x:Double>
    <x:Double x:Key="Ui.ToolButtonSize">26</x:Double>
    <x:Double x:Key="Ui.NumWidth">70</x:Double>
    <x:Double x:Key="Ui.NumMinHeight">22</x:Double>
    <x:Double x:Key="Ui.TabMinHeight">24</x:Double>
    <x:Double x:Key="Ui.SliderThumb">12</x:Double>
    <x:Double x:Key="Ui.SpaceScale">1</x:Double>
    <x:Double x:Key="Ui.DockTabHeight">26</x:Double>
    <Thickness x:Key="Ui.ListItemPadding">8,3</Thickness>
    <Thickness x:Key="Ui.ActPadding">9,1</Thickness>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://DeSignMage/Shell/ShellStyles.axaml" />
  </Application.Styles>
</Application>
