<Project Sdk="Microsoft.NET.Sdk">

  <!-- Avalonia desktop shell: windows, panels, menus, the Skia canvas control. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DeSignMage.App</RootNamespace>
    <AssemblyName>DeSignMage</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Temporary app icon from the user (2026-10-12); source and generator notes in Assets/README.md. -->
    <ApplicationIcon>Assets\DeSignMage.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- File description shown in the exe's Properties. The version and the rest of the identity are in Directory.Build.props. -->
    <AssemblyTitle>DeSign Mage</AssemblyTitle>
  </PropertyGroup>

  <!-- Startup: a published build (`dotnet publish -r win-x64 ...`, framework-dependent or self-contained)
       is precompiled to ReadyToRun machine code, so the first window appears without waiting for the JIT: about 1.9 s -> 1.0 s on the dev PC.
       It needs a runtime identifier, so plain `dotnet build` / `dotnet test` are not affected. Tiered compilation and TieredPGO stay at the
       runtime defaults: turning either off did not help startup (measured). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Only our own assemblies (DeSignMage.exe's DeSignMage.dll and DeSignMage.*.dll) are precompiled. Every other managed file (Avalonia, SkiaSharp,
       PdfPig, ...) is published byte-identical to its NuGet package, so the files the release signing does not cover are still the vendors' originals
       and Smart App Control / SmartScreen can recognize them. Costs some startup time; set -p:PrecompileAllAssemblies=true for the fastest personal build. -->
  <Target Name="PrecompileOnlyOurAssemblies" AfterTargets="_ComputeAssembliesToPostprocessOnPublish" Condition="'$(PublishReadyToRun)' == 'true' and '$(PrecompileAllAssemblies)' != 'true'">
    <ItemGroup>
      <_PublishedAssembly Include="@(ResolvedFileToPublish->WithMetadataValue('PostprocessAssembly', 'true'))" />
      <_ForeignAssembly Include="@(_PublishedAssembly)" Condition="'%(Filename)' != 'DeSignMage' and !$([System.String]::new('%(Filename)').StartsWith('DeSignMage.'))" />
      <PublishReadyToRunExclude Include="@(_ForeignAssembly->'%(Filename)%(Extension)')" />
    </ItemGroup>
  </Target>

  <!-- The native symbol files that come with SkiaSharp and HarfBuzzSharp are about 100 MB and useless to a user: leave them out of a publish.
       The program's own .pdb files stay (small), so crash reports keep their line numbers. -->
  <Target Name="LeaveOutNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_NativeSymbol Include="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' and $([System.String]::new('%(Filename)').StartsWith('lib'))" />
      <ResolvedFileToPublish Remove="@(_NativeSymbol)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The installer package id (see Directory.Build.props); the tests check that it cannot collide with the data folder. -->
    <AssemblyMetadata Include="UpdatePackId" Value="$(UpdatePackId)" />
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm'))Z" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeSignMage.App.Tests" />
  </ItemGroup>

  <!-- Window/taskbar icon, loaded as an Avalonia resource. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\DeSignMage.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeSignMage.Core\DeSignMage.Core.csproj" />
    <ProjectReference Include="..\DeSignMage.Feedback\DeSignMage.Feedback.csproj" />
    <ProjectReference Include="..\DeSignMage.Formats\DeSignMage.Formats.csproj" />
    <ProjectReference Include="..\DeSignMage.Geometry\DeSignMage.Geometry.csproj" />
    <ProjectReference Include="..\DeSignMage.Imaging\DeSignMage.Imaging.csproj" />
    <ProjectReference Include="..\DeSignMage.Rendering\DeSignMage.Rendering.csproj" />
    <ProjectReference Include="..\DeSignMage.Text\DeSignMage.Text.csproj" />
    <ProjectReference Include="..\DeSignMage.Vectorize\DeSignMage.Vectorize.csproj" />
  </ItemGroup>

</Project>

