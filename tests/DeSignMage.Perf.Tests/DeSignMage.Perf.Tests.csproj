<Project Sdk="Microsoft.NET.Sdk">

  <!-- Speed budgets: opening the big sample, re-recording the picture after an edit, hit testing, a
       10,000-shape document. The budgets are generous (several times the measured Debug time) so they only fail on a real regression. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeSignMage.Core\DeSignMage.Core.csproj" />
    <ProjectReference Include="..\..\src\DeSignMage.Formats\DeSignMage.Formats.csproj" />
    <ProjectReference Include="..\..\src\DeSignMage.Geometry\DeSignMage.Geometry.csproj" />
    <ProjectReference Include="..\..\src\DeSignMage.Rendering\DeSignMage.Rendering.csproj" />
    <ProjectReference Include="..\..\src\DeSignMage.Text\DeSignMage.Text.csproj" />
  </ItemGroup>

  <!-- Sample files that are not in the repository (local-testdata/, see the README): tests that need them are skipped when missing. -->
  <ItemGroup>
    <Compile Include="..\Shared\LocalData.cs" Link="Shared\LocalData.cs" />
    <Compile Include="..\Shared\LocalFacts.cs" Link="Shared\LocalFacts.cs" />
  </ItemGroup>

</Project>
